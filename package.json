{
  "name": "avex-crm-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AVEX CRM - AI Powered Business CRM & SaaS Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "audit:employees-inventory": "npx tsx scratch/functional-audit-employees-inventory.ts",
    "audit:finance-consolidation": "npx tsx scratch/functional-audit-finance-consolidation.ts"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.4.2",
    "turbo-windows-64": "^2.8.17",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "resend": "^6.19.0"
  }
}
