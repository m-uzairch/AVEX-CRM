# ==============================================================================
# AVEX CRM - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local for local development.
# For Vercel production deployment, set these variables in the Vercel Project Settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL DOCKER POSTGRESQL (docker-compose.yml)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=avex_crm
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. DATABASE CONNECTIONS (PRISMA ORM)
# ------------------------------------------------------------------------------
# DATABASE_URL: Runtime pooled database connection string (e.g. Supabase connection pooler / PgBouncer on port 6543)
# In local dev: "postgresql://postgres:password@localhost:5432/avex_crm?schema=public"
DATABASE_URL="postgresql://postgres:password@localhost:5432/avex_crm?schema=public"

# DIRECT_URL: Direct non-pooled database connection string used for migrations (Prisma migrate deploy on port 5432)
# In local dev: same as DATABASE_URL
DIRECT_URL="postgresql://postgres:password@localhost:5432/avex_crm?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# JWT_SECRET: Secret key for signing and verifying JSON Web Tokens (session cookies)
# CRITICAL: Must be at least 32 characters in production (e.g., openssl rand -base64 32)
JWT_SECRET=avex_crm_secure_jwt_secret_dev_32char_minimum!

# CRON_SECRET: Secret token to authorize Vercel cron invocation endpoints (Bearer token verification)
CRON_SECRET=your_secure_cron_secret_token_here_32chars

# ------------------------------------------------------------------------------
# 4. SUPABASE AUTH & BACKEND SERVICES
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 5. ASYNC JOB QUEUE & CACHE
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 6. ARTIFICIAL INTELLIGENCE PROVIDERS
# ------------------------------------------------------------------------------
# AI_PROVIDER options: 'GEMINI' | 'OPENAI' | 'MOCK'
AI_PROVIDER=GEMINI
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAIL (RESEND)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

# ------------------------------------------------------------------------------
# 8. WHATSAPP BUSINESS API (OPTIONAL)
# ------------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id

# ------------------------------------------------------------------------------
# 9. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
