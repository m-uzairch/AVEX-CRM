# AVEX CRM Environment Variables Template

# Supabase Auth & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
DATABASE_URL="postgresql://postgres:password@localhost:5432/avex_crm?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/avex_crm?schema=public"

# Async Job Queue & Cache
REDIS_URL=redis://localhost:6379

# Artificial Intelligence (Gemini API)
GEMINI_API_KEY=your-gemini-api-key

# Transactional Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id

# Application Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
