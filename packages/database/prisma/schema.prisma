// AVEX CRM Shared Monorepo Database Schema
// Production-Ready Multi-Tenant Enterprise Data Models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum BusinessType {
  DIGITAL
  PHYSICAL
  BOTH
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  PROSPECT
  LOST
  BLACKLISTED
  ARCHIVED
}

enum CustomerPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  PLANNING
  PENDING
  IN_PROGRESS
  ON_HOLD
  REVIEW
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectMemberRole {
  PROJECT_MANAGER
  MEMBER
  VIEWER
}

enum ProjectMilestoneStatus {
  NOT_STARTED
  PLANNING
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
  DELAYED
  CANCELLED
}

enum MilestonePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  BLOCKED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ChangeRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum MessageSenderType {
  CLIENT
  TEAM
}

enum FileCategory {
  DOCUMENTS
  DESIGNS
  CONTRACTS
  REPORTS
  IMAGES
  DEVELOPMENT
  DELIVERABLES
  OTHER
}

enum ConversationType {
  PROJECT_CHAT
  DIRECT
  CLIENT
}

enum MeetingType {
  ONLINE
  IN_PERSON
}

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AnnouncementType {
  COMPANY
  TEAM
  PROJECT
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  VIEWED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

// ==========================================
// MODELS
// ==========================================

/// Company represents a multi-tenant workspace entity.
model Company {
  id           String        @id @default(uuid())
  name         String
  businessType BusinessType  @default(DIGITAL)
  logo         String?
  timezone     String        @default("UTC")
  currency     String        @default("USD")
  status       CompanyStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  users        User[]
  invitations  Invitation[]
  activityLogs ActivityLog[]
  customers          Customer[]
  leads              Lead[]
  leadStageHistories LeadStageHistory[]
  importJobs         ImportJob[]
  tags               Tag[]
  savedFilters       SavedFilter[]
  recentSearches     RecentSearch[]
  projects           Project[]
  projectCategories  ProjectCategory[]
  projectTemplates   ProjectTemplate[]
  projectMilestones  ProjectMilestone[]
  projectNotes       ProjectNote[]
  tasks              Task[]
  clientAccounts     ClientAccount[]
  changeRequests     ChangeRequest[]
  clientMessages     ClientMessage[]
  projectFolders     ProjectFolder[]
  projectFiles       ProjectFile[]
  conversations      Conversation[]
  meetings           Meeting[]
  announcements      Announcement[]
  meetingNotes       MeetingNote[]
  reportSchedules      ReportSchedule[]
  dashboardPreferences DashboardPreference[]
  reportHistories      ReportHistory[]
  projectDeliveries    ProjectDelivery[]
  completionChecklists CompletionChecklist[]
  archiveRecords       ArchiveRecord[]
  invoices             Invoice[]
  invoicePayments      InvoicePayment[]
  invoiceTemplates     InvoiceTemplate[]
  companyBranding      CompanyBranding?
  quotations           Quotation[]
  paymentNotes         PaymentNote[]
  expenseCategories    ExpenseCategory[]
  vendors              Vendor[]
  expenses             Expense[]
  financialDashboardPreferences FinancialDashboardPreference[]

  @@map("companies")
}

/// User represents an authenticated user belonging to a specific company workspace.
model User {
  id             String     @id @default(uuid())
  supabaseUserId String     @unique
  companyId      String
  fullName       String
  email          String     @unique
  avatar         String?
  status         UserStatus @default(ACTIVE)
  lastLogin      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  company             Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profile             UserProfile?
  userRoles           UserRole[]
  sessions            Session[]
  activityLogs        ActivityLog[]
  createdInvites      Invitation[]       @relation("InvitedBy")
  assignedCustomers   Customer[]         @relation("AssignedCustomers")
  customerNotes       CustomerNote[]
  assignedLeads       Lead[]             @relation("AssignedLeads")
  leadNotes           LeadNote[]         @relation("LeadNoteAuthor")
  stageHistoryUpdates LeadStageHistory[] @relation("LeadStageHistoryUser")
  importJobs          ImportJob[]        @relation("ImportJobAuthor")
  savedFilters        SavedFilter[]
  recentSearches      RecentSearch[]
  managedProjects     Project[]          @relation("ManagedProjects")
  projectMemberships  ProjectMember[]
  createdProjectNotes ProjectNote[]      @relation("ProjectNoteAuthor")
  createdTasks        Task[]             @relation("TaskAuthor")
  taskAssignments     TaskAssignee[]
  taskComments        TaskComment[]
  timeEntries         TimeEntry[]
  createdFolders      ProjectFolder[]
  uploadedFiles       ProjectFile[]
  uploadedVersions    FileVersion[]
  milestoneAssignments    MilestoneAssignee[]
  createdMilestones       ProjectMilestone[]           @relation("MilestoneAuthor")
  conversationParticipants ConversationParticipant[]
  sentMessages            Message[]                    @relation("MessageSender")
  organizedMeetings       Meeting[]                    @relation("MeetingOrganizer")
  meetingParticipations   MeetingParticipant[]
  authoredMeetingNotes    MeetingNote[]                @relation("MeetingNoteAuthor")
  createdAnnouncements    Announcement[]               @relation("AnnouncementAuthor")
  reportSchedules         ReportSchedule[]             @relation("ScheduledReportAuthor")
  dashboardPreference     DashboardPreference?
  reportHistories         ReportHistory[]              @relation("GeneratedReportAuthor")
  deliveredProjects       ProjectDelivery[]            @relation("ProjectDeliveredBy")
  approvedDeliveries      DeliveryApproval[]           @relation("DeliveryApprovedBy")
  archivedRecords         ArchiveRecord[]              @relation("RecordArchivedBy")
  restoredRecords         ArchiveRecord[]              @relation("RecordRestoredBy")
  createdInvoices         Invoice[]                    @relation("InvoiceAuthor")
  updatedInvoices         Invoice[]                    @relation("InvoiceUpdater")
  salesRepInvoices        Invoice[]                    @relation("InvoiceSalesRep")
  recordedPayments        InvoicePayment[]             @relation("PaymentRecordedBy")
  createdQuotations       Quotation[]                  @relation("QuotationAuthor")
  updatedQuotations       Quotation[]                  @relation("QuotationUpdater")
  salesRepQuotations      Quotation[]                  @relation("QuotationSalesRep")
  quotationVersions       QuotationVersion[]           @relation("QuotationVersionAuthor")
  createdPaymentNotes     PaymentNote[]                @relation("PaymentNoteAuthor")
  createdExpenseCategories ExpenseCategory[]          @relation("ExpenseCategoryAuthor")
  createdVendors           Vendor[]                   @relation("VendorAuthor")
  submittedExpenses        Expense[]                  @relation("ExpenseEmployee")
  reviewedExpenses         Expense[]                  @relation("ExpenseReviewer")
  createdExpenses          Expense[]                  @relation("ExpenseAuthor")
  updatedExpenses          Expense[]                  @relation("ExpenseUpdater")
  financialDashboardPreference FinancialDashboardPreference?

  @@index([companyId])
  @@index([email])
  @@index([supabaseUserId])
  @@map("users")
}

/// UserProfile stores detailed personal and professional info separate from auth data.
model UserProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  phone        String?
  address      String?
  jobTitle     String?
  bio          String?
  profileImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// Role defines a system or custom RBAC role.
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

/// Permission defines an atomic access capability token.
model Permission {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  group     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// RolePermission connects Roles with atomic Permission capabilities.
model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// UserRole connects Users with assigned Roles.
model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Invitation stores pending user invitations to join a company workspace.
model Invitation {
  id          String           @id @default(uuid())
  email       String
  role        String
  companyId   String
  token       String           @unique
  expiresAt   DateTime
  status      InvitationStatus @default(PENDING)
  createdById String
  createdAt   DateTime         @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User    @relation("InvitedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([token])
  @@index([email])
  @@map("invitations")
}

/// Session tracks user login devices and active session history.
model Session {
  id           String   @id @default(uuid())
  userId       String
  deviceIp     String?
  userAgent    String?
  lastActivity DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// ActivityLog stores audit trail logs for business actions.
model ActivityLog {
  id          String   @id @default(uuid())
  userId      String?
  companyId   String
  action      String
  module      String
  category    String?  @default("CRM")
  entityType  String?
  entityId    String?
  description String
  metadata    Json?
  timestamp   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
  @@index([timestamp])
  @@index([companyId, entityType, entityId])
  @@map("activity_logs")
}

/// Customer stores company client profiles and lifecycle metadata.
model Customer {
  id                 String           @id @default(uuid())
  companyId          String
  assignedEmployeeId String?
  name               String
  companyName        String
  email              String
  phone              String
  alternatePhone     String?
  country            String?
  state              String?
  city               String?
  address            String?
  postalCode         String?
  industry           String?
  businessType       String?
  website            String?
  companySize        String?
  status             CustomerStatus   @default(ACTIVE)
  source             String?
  priority           CustomerPriority @default(MEDIUM)
  tags               String[]         @default([])
  isArchived         Boolean          @default(false)
  deletedAt          DateTime?
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedEmployee User?          @relation("AssignedCustomers", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  notes            CustomerNote[]
  convertedLead    Lead?          @relation("ConvertedFromLead")
  projects         Project[]
  tasks            Task[]
  clientAccount    ClientAccount?
  changeRequests   ChangeRequest[]
  invoices         Invoice[]
  quotations       Quotation[]
  payments         InvoicePayment[]

  @@index([companyId])
  @@index([assignedEmployeeId])
  @@index([email])
  @@index([status])
  @@index([isArchived])
  @@index([deletedAt])
  @@map("customers")
}

/// CustomerNote stores internal team notes on customer accounts.
model CustomerNote {
  id          String   @id @default(uuid())
  customerId  String
  companyId   String
  content     String
  isPinned    Boolean  @default(false)
  attachments Json?
  mentions    Json?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([companyId])
  @@index([isPinned])
  @@map("customer_notes")
}

// ==========================================
// LEAD MANAGEMENT ENUMS & MODELS
// ==========================================

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Lead stores sales prospect profiles, qualification scores, and pipeline lifecycle state.
model Lead {
  id                  String       @id @default(uuid())
  companyId           String
  assignedEmployeeId  String?
  name                String
  companyName         String
  email               String
  phone               String
  alternatePhone      String?
  country             String?
  state               String?
  city                String?
  address             String?
  postalCode          String?
  industry            String?
  businessType        String?
  website             String?
  companySize         String?
  source              String?      @default("Website")
  status              LeadStatus   @default(NEW)
  priority            LeadPriority @default(MEDIUM)
  score               Int                @default(50)
  winProbability      Int                @default(50)
  stageOrder          Int                @default(0)
  expectedDealValue   Float?
  expectedClosingDate DateTime?
  tags                String[]           @default([])
  convertedCustomerId String?            @unique
  isConverted         Boolean            @default(false)
  convertedAt         DateTime?
  isArchived          Boolean            @default(false)
  deletedAt           DateTime?
  lastContactAt       DateTime?
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedEmployee  User?              @relation("AssignedLeads", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  convertedCustomer Customer?          @relation("ConvertedFromLead", fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  notes             LeadNote[]
  stageHistory      LeadStageHistory[]
  quotations        Quotation[]

  @@index([companyId])
  @@index([assignedEmployeeId])
  @@index([email])
  @@index([status])
  @@index([score])
  @@index([isArchived])
  @@index([deletedAt])
  @@map("leads")
}

/// LeadNote stores internal team notes on lead opportunities.
model LeadNote {
  id          String   @id @default(uuid())
  leadId      String
  companyId   String
  content     String
  isPinned    Boolean  @default(false)
  attachments Json?
  mentions    Json?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User @relation("LeadNoteAuthor", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([companyId])
  @@index([isPinned])
  @@map("lead_notes")
}

/// LeadStageHistory tracks every stage transition for a lead in the Kanban pipeline.
model LeadStageHistory {
  id          String     @id @default(uuid())
  leadId      String
  companyId   String
  fromStage   LeadStatus
  toStage     LeadStatus
  updatedById String?
  createdAt   DateTime   @default(now())

  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation("LeadStageHistoryUser", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([companyId])
  @@map("lead_stage_history")
}

// ==========================================
// IMPORT JOB ENUMS & MODELS
// ==========================================

enum ImportJobStatus {
  PENDING
  PROCESSING
  PREVIEW_READY
  IMPORTING
  COMPLETED
  FAILED
}

/// ImportJob tracks AI/OCR lead import metadata, preview rows, error logs, and execution status.
model ImportJob {
  id             String          @id @default(uuid())
  companyId      String
  fileName       String
  fileType       String
  fileSize       Int
  status         ImportJobStatus @default(PENDING)
  totalRecords   Int             @default(0)
  successCount   Int             @default(0)
  duplicateCount Int             @default(0)
  failedCount    Int             @default(0)
  createdById    String?
  extractedData  Json?
  fieldMapping   Json?
  errorLog       Json?
  startedAt      DateTime        @default(now())
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ImportJobAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([status])
  @@map("import_jobs")
}

// ==========================================
// SEARCH, SAVED FILTERS & TAG MODELS
// ==========================================

/// Tag represents a workspace-wide tag entity with custom color.
model Tag {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  color       String   @default("#3B82F6")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([name])
  @@map("tags")
}

/// SavedFilter stores user-defined filter presets for quick application.
model SavedFilter {
  id           String   @id @default(uuid())
  companyId    String
  userId       String
  module       String   @default("ALL")
  name         String
  filterConfig Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@map("saved_filters")
}

/// RecentSearch tracks per-user recent search term history.
model RecentSearch {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  query     String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("recent_searches")
}

// ==========================================
// PROJECT MANAGEMENT MODELS
// ==========================================

/// Project Category model
model ProjectCategory {
  id          String    @id @default(uuid())
  companyId   String
  name        String
  description String?
  color       String    @default("#3B82F6")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([companyId])
  @@map("project_categories")
}

/// Project model
model Project {
  id                     String          @id @default(uuid())
  companyId              String
  projectCode            String
  name                   String
  description            String?
  customerId             String?
  projectManagerId       String?
  categoryId             String?
  status                 ProjectStatus   @default(PLANNING)
  priority               ProjectPriority @default(MEDIUM)
  businessType           String?
  currency               String          @default("USD")
  templateId             String?
  startDate              DateTime?
  expectedCompletionDate DateTime?
  actualCompletionDate   DateTime?
  budget                 Float?
  isArchived             Boolean         @default(false)
  deletedAt              DateTime?
  createdBy              String?
  updatedBy              String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  projectManager User?            @relation("ManagedProjects", fields: [projectManagerId], references: [id], onDelete: SetNull)
  category       ProjectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  members        ProjectMember[]
  milestones     ProjectMilestone[]
  notes          ProjectNote[]
  tasks          Task[]
  changeRequests ChangeRequest[]
  messages       ClientMessage[]
  folders        ProjectFolder[]
  files          ProjectFile[]
  conversations  Conversation[]
  meetings       Meeting[]
  announcements  Announcement[]
  deliveries          ProjectDelivery[]
  completionChecklist CompletionChecklist?
  archiveRecords      ArchiveRecord[]
  invoices            Invoice[]
  expenses            Expense[]

  @@unique([companyId, projectCode])
  @@index([companyId])
  @@index([customerId])
  @@index([projectManagerId])
  @@index([status])
  @@index([priority])
  @@index([isArchived])
  @@index([deletedAt])
  @@map("projects")
}

/// Project Member (Junction between Project and User)
model ProjectMember {
  id        String            @id @default(uuid())
  projectId String
  userId    String
  role      ProjectMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

/// Project Template Placeholder model
model ProjectTemplate {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  description String?
  category    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("project_templates")
}

/// Project Milestone model
model ProjectMilestone {
  id                 String                 @id @default(uuid())
  projectId          String
  companyId          String
  title              String
  description        String?
  order              Int                    @default(0)
  status             ProjectMilestoneStatus @default(NOT_STARTED)
  priority           MilestonePriority      @default(MEDIUM)
  startDate          DateTime?
  dueDate            DateTime?
  completionDate     DateTime?
  progressPercentage Int                    @default(0)
  estimatedHours     Float?
  budgetAllocation   Float?
  isArchived         Boolean                @default(false)
  deletedAt          DateTime?
  createdById        String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User?                 @relation("MilestoneAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  assignees    MilestoneAssignee[]
  dependencies MilestoneDependency[] @relation("MilestoneDependencies")
  blockedBy    MilestoneDependency[] @relation("BlockedMilestones")

  @@index([projectId])
  @@index([companyId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([isArchived])
  @@index([deletedAt])
  @@map("project_milestones")
}

/// Milestone Assignee junction
model MilestoneAssignee {
  id          String   @id @default(uuid())
  milestoneId String
  userId      String
  createdAt   DateTime @default(now())

  milestone ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, userId])
  @@index([milestoneId])
  @@index([userId])
  @@map("milestone_assignees")
}

/// Milestone Dependency junction
model MilestoneDependency {
  id                   String   @id @default(uuid())
  milestoneId          String
  dependsOnMilestoneId String
  createdAt            DateTime @default(now())

  milestone ProjectMilestone @relation("MilestoneDependencies", fields: [milestoneId], references: [id], onDelete: Cascade)
  dependsOn ProjectMilestone @relation("BlockedMilestones", fields: [dependsOnMilestoneId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, dependsOnMilestoneId])
  @@index([milestoneId])
  @@index([dependsOnMilestoneId])
  @@map("milestone_dependencies")
}

/// ProjectNote stores internal team notes on project workspaces.
model ProjectNote {
  id          String   @id @default(uuid())
  projectId   String
  companyId   String
  content     String
  isPinned    Boolean  @default(false)
  attachments Json?
  mentions    Json?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ProjectNoteAuthor", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([companyId])
  @@index([isPinned])
  @@map("project_notes")
}

// ==========================================
// TASK MANAGEMENT MODELS
// ==========================================

/// Task model
model Task {
  id             String       @id @default(uuid())
  companyId      String
  projectId      String
  customerId     String?
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  estimatedHours Float?
  totalTimeSpent Float        @default(0) // In seconds
  labels         String[]     @default([])
  tags           String[]     @default([])
  createdById    String?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customer   Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy  User?            @relation("TaskAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  assignees  TaskAssignee[]
  subtasks   Subtask[]
  comments   TaskComment[]
  attachments TaskAttachment[]
  timeEntries TimeEntry[]
  dependencies TaskDependency[] @relation("TaskDependencies")
  blockedTasks TaskDependency[] @relation("BlockedTasks")

  @@index([companyId])
  @@index([projectId])
  @@index([customerId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("tasks")
}

/// Task Assignee junction
model TaskAssignee {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("task_assignees")
}

/// Subtask model
model Subtask {
  id          String    @id @default(uuid())
  taskId      String
  title       String
  isCompleted Boolean   @default(false)
  assigneeId  String?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("subtasks")
}

/// Task Comment model
model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  companyId String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([companyId])
  @@map("task_comments")
}

/// Task Attachment model
model TaskAttachment {
  id           String   @id @default(uuid())
  taskId       String
  fileName     String
  fileUrl      String
  fileSize     Int
  uploadedById String
  createdAt    DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_attachments")
}

/// Time Entry for Task Time Tracking
model TimeEntry {
  id              String    @id @default(uuid())
  taskId          String
  userId          String
  startTime       DateTime  @default(now())
  endTime         DateTime?
  durationSeconds Int       @default(0)
  createdAt       DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@map("time_entries")
}

/// Task Dependency (Task A blocks Task B)
model TaskDependency {
  id              String   @id @default(uuid())
  taskId          String
  dependsOnTaskId String
  createdAt       DateTime @default(now())

  task        Task @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task @relation("BlockedTasks", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([taskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

// ==========================================
// CLIENT PORTAL MODELS
// ==========================================

/// ClientAccount model for Client Portal login
model ClientAccount {
  id           String    @id @default(uuid())
  companyId    String
  customerId   String    @unique
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  avatar       String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([customerId])
  @@map("client_accounts")
}

/// ChangeRequest model submitted by clients
model ChangeRequest {
  id            String              @id @default(uuid())
  companyId     String
  projectId     String
  customerId    String
  title         String
  description   String
  priority      TaskPriority        @default(MEDIUM)
  status        ChangeRequestStatus @default(SUBMITTED)
  attachmentUrl String?
  createdById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
  @@index([customerId])
  @@map("change_requests")
}

/// ClientMessage model for project messaging
model ClientMessage {
  id            String            @id @default(uuid())
  companyId     String
  projectId     String
  senderId      String
  senderType    MessageSenderType @default(CLIENT)
  content       String
  attachmentUrl String?
  isRead        Boolean           @default(false)
  createdAt     DateTime          @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
  @@map("client_messages")
}

// ==========================================
// FILE & DOCUMENT MANAGEMENT MODELS
// ==========================================

/// ProjectFolder model for directory organization
model ProjectFolder {
  id          String   @id @default(uuid())
  companyId   String
  projectId   String
  name        String
  parentId    String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    ProjectFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  ProjectFolder[] @relation("FolderHierarchy")
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  files     ProjectFile[]

  @@index([companyId])
  @@index([projectId])
  @@index([parentId])
  @@map("project_folders")
}

/// ProjectFile model
model ProjectFile {
  id              String       @id @default(uuid())
  companyId       String
  projectId       String
  folderId        String?
  name            String
  originalName    String
  fileUrl         String
  fileSize        Int // Size in bytes
  fileType        String // MIME type / extension
  category        FileCategory @default(DOCUMENTS)
  isClientVisible Boolean      @default(false)
  currentVersion  Int          @default(1)
  uploadedById    String?
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder     ProjectFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  versions   FileVersion[]

  @@index([companyId])
  @@index([projectId])
  @@index([folderId])
  @@index([category])
  @@index([isClientVisible])
  @@index([deletedAt])
  @@map("project_files")
}

/// FileVersion model for version history
model FileVersion {
  id            String   @id @default(uuid())
  fileId        String
  versionNumber Int
  fileUrl       String
  fileSize      Int
  changeNotes   String?
  uploadedById  String?
  createdAt     DateTime @default(now())

  file       ProjectFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  uploadedBy User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([fileId])
  @@map("file_versions")
}

// ==========================================
// COMMUNICATION & MEETINGS MODELS
// ==========================================

/// Conversation model (project chat, direct, or client)
model Conversation {
  id          String           @id @default(uuid())
  companyId   String
  projectId   String?
  type        ConversationType @default(PROJECT_CHAT)
  name        String?
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company      Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      Project?                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([companyId])
  @@index([projectId])
  @@index([type])
  @@map("conversations")
}

/// ConversationParticipant junction model
model ConversationParticipant {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_participants")
}

/// Message model for conversation threads
model Message {
  id             String   @id @default(uuid())
  conversationId String
  companyId      String
  senderId       String
  content        String
  isEdited       Boolean  @default(false)
  isDeleted      Boolean  @default(false)
  replyToId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?          @relation("MessageReplies", fields: [replyToId], references: [id])
  replies      Message[]         @relation("MessageReplies")
  attachments  MessageAttachment[]

  @@index([conversationId])
  @@index([senderId])
  @@index([companyId])
  @@map("messages")
}

/// MessageAttachment model
model MessageAttachment {
  id        String   @id @default(uuid())
  messageId String
  fileUrl   String
  fileName  String
  fileSize  Int
  fileType  String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

/// Meeting model for scheduled meetings
model Meeting {
  id              String        @id @default(uuid())
  companyId       String
  projectId       String?
  title           String
  description     String?
  organizerId     String
  startTime       DateTime
  endTime         DateTime
  timezone        String        @default("UTC")
  meetingType     MeetingType   @default(ONLINE)
  meetingLink     String?
  linkPlatform    String?
  status          MeetingStatus @default(SCHEDULED)
  calendarEventId String?
  isClientVisible Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizer    User                 @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  participants MeetingParticipant[]
  notes        MeetingNote[]

  @@index([companyId])
  @@index([projectId])
  @@index([organizerId])
  @@index([status])
  @@index([startTime])
  @@map("meetings")
}

/// MeetingParticipant junction model
model MeetingParticipant {
  id        String   @id @default(uuid())
  meetingId String
  userId    String
  joinedAt  DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([userId])
  @@map("meeting_participants")
}

/// MeetingNote model
model MeetingNote {
  id        String   @id @default(uuid())
  meetingId String
  companyId String
  content   String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author  User    @relation("MeetingNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([companyId])
  @@map("meeting_notes")
}

/// Announcement model
model Announcement {
  id          String               @id @default(uuid())
  companyId   String
  projectId   String?
  type        AnnouncementType     @default(COMPANY)
  priority    AnnouncementPriority @default(NORMAL)
  title       String
  description String
  expiresAt   DateTime?
  authorId    String
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User     @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
  @@index([type])
  @@index([isActive])
  @@map("announcements")
}

// ==========================================
// REPORT & ANALYTICS MODELS
// ==========================================

/// ReportSchedule model for recurring scheduled reports
model ReportSchedule {
  id           String    @id @default(uuid())
  companyId    String
  createdById  String
  title        String
  reportType   String    // PROJECT_PERFORMANCE, TEAM_ANALYTICS, TASK_ANALYTICS, MILESTONE_ANALYTICS, TIME_TRACKING, BUDGET_REPORT, RESOURCE_UTILIZATION, PROJECT_HEALTH
  frequency    String    // DAILY, WEEKLY, MONTHLY
  recipients   String[]  // Array of emails
  exportFormat String    @default("PDF") // PDF, EXCEL, CSV
  filters      Json?
  isActive     Boolean   @default(true)
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ScheduledReportAuthor", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([createdById])
  @@index([isActive])
  @@map("report_schedules")
}

/// DashboardPreference model for storing per-user dashboard widget configurations
model DashboardPreference {
  id        String   @id @default(uuid())
  companyId String
  userId    String   @unique
  layout    Json     // Array of widget objects { id, title, isVisible, order }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@map("dashboard_preferences")
}

/// ReportHistory model for logging generated and exported reports
model ReportHistory {
  id            String   @id @default(uuid())
  companyId     String
  generatedById String?
  reportType    String
  title         String
  exportFormat  String   // PDF, EXCEL, CSV
  fileUrl       String?
  fileSize      Int?
  filters       Json?
  createdAt     DateTime @default(now())

  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  generatedBy User?   @relation("GeneratedReportAuthor", fields: [generatedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([generatedById])
  @@index([createdAt])
  @@map("report_histories")
}

// ==========================================
// PROJECT COMPLETION & DELIVERY MODELS
// ==========================================

/// ProjectDelivery model
model ProjectDelivery {
  id                    String   @id @default(uuid())
  projectId             String
  companyId             String
  deliveredById         String
  deliveryDate          DateTime @default(now())
  deliveryNotes         String?
  deliveryFiles         Json?    // Array of file metadata objects
  clientApprovalStatus  String   @default("PENDING") // PENDING, APPROVED, CHANGES_REQUESTED
  clientFeedback        String?
  requestedChangesNotes String?
  deliveredAt           DateTime @default(now())
  approvedAt            DateTime?
  rejectedAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deliveredBy User               @relation("ProjectDeliveredBy", fields: [deliveredById], references: [id], onDelete: Cascade)
  approvals   DeliveryApproval[]

  @@index([projectId])
  @@index([companyId])
  @@index([deliveredById])
  @@index([clientApprovalStatus])
  @@map("project_deliveries")
}

/// DeliveryApproval model
model DeliveryApproval {
  id            String   @id @default(uuid())
  deliveryId    String
  approvedById  String?
  status        String   // APPROVED, CHANGES_REQUESTED
  feedback      String?
  changesNeeded String?
  createdAt     DateTime @default(now())

  delivery   ProjectDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  approvedBy User?           @relation("DeliveryApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([deliveryId])
  @@index([approvedById])
  @@map("delivery_approvals")
}

/// CompletionChecklist model
model CompletionChecklist {
  id                         String   @id @default(uuid())
  projectId                  String   @unique
  companyId                  String
  allTasksCompleted          Boolean  @default(false)
  allMilestonesCompleted     Boolean  @default(false)
  clientDeliverablesUploaded Boolean  @default(false)
  finalDocUploaded           Boolean  @default(false)
  internalReviewCompleted    Boolean  @default(false)
  clientApprovalReceived     Boolean  @default(false)
  customItems                Json?    // Array of items { id, label, isDone }
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([companyId])
  @@map("completion_checklists")
}

/// ArchiveRecord model
model ArchiveRecord {
  id           String    @id @default(uuid())
  projectId    String
  companyId    String
  archivedById String
  archivedAt   DateTime  @default(now())
  restoredById String?
  restoredAt   DateTime?
  reason       String?
  createdAt    DateTime  @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  archivedBy User    @relation("RecordArchivedBy", fields: [archivedById], references: [id], onDelete: Cascade)
  restoredBy User?   @relation("RecordRestoredBy", fields: [restoredById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([companyId])
  @@index([archivedById])
  @@map("archive_records")
}

// ==========================================
// INVOICE & PAYMENT MANAGEMENT MODELS
// ==========================================

/// Invoice model
model Invoice {
  id               String        @id @default(uuid())
  companyId        String
  invoiceNumber    String        // e.g. INV-000001
  customerId       String
  projectId        String?
  salesRepId       String?
  invoiceDate      DateTime      @default(now())
  dueDate          DateTime
  status           InvoiceStatus @default(DRAFT)
  currency         String        @default("USD")
  subtotal         Float         @default(0)
  discountAmount   Float         @default(0)
  taxAmount        Float         @default(0)
  grandTotal       Float         @default(0)
  amountPaid       Float         @default(0)
  remainingBalance Float         @default(0)
  notes            String?
  termsConditions  String?
  sentAt           DateTime?
  viewedAt         DateTime?
  paidAt           DateTime?
  deletedAt        DateTime?
  createdById      String?
  updatedById      String?
  templateId       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  salesRep  User?            @relation("InvoiceSalesRep", fields: [salesRepId], references: [id], onDelete: SetNull)
  createdBy User?            @relation("InvoiceAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?            @relation("InvoiceUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  template  InvoiceTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  items     InvoiceItem[]
  payments  InvoicePayment[]
  notesList PaymentNote[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([customerId])
  @@index([projectId])
  @@index([status])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("invoices")
}

/// InvoiceItem model
model InvoiceItem {
  id           String   @id @default(uuid())
  invoiceId    String
  name         String
  description  String?
  quantity     Float    @default(1)
  unitPrice    Float    @default(0)
  discountRate Float    @default(0)
  taxRate      Float    @default(0)
  lineTotal    Float    @default(0)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

/// InvoicePayment model (tracks manual payments only)
model InvoicePayment {
  id              String   @id @default(uuid())
  invoiceId       String
  companyId       String
  customerId      String?
  projectId       String?
  amount          Float
  paymentDate     DateTime @default(now())
  paymentMethod   String   @default("BANK_TRANSFER") // BANK_TRANSFER, CASH, CHEQUE, CREDIT_CARD, DEBIT_CARD, MOBILE_WALLET, OTHER
  referenceNumber String?
  notes           String?
  internalNotes   String?
  deletedAt       DateTime?
  recordedById    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt @default(now())

  invoice    Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  project    Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  recordedBy User?         @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  notesList  PaymentNote[]

  @@index([invoiceId])
  @@index([companyId])
  @@index([customerId])
  @@index([projectId])
  @@index([recordedById])
  @@index([deletedAt])
  @@map("invoice_payments")
}

/// InvoiceTemplate model
model InvoiceTemplate {
  id                   String   @id @default(uuid())
  companyId            String
  name                 String
  layoutStyle          String   @default("CLASSIC") // CLASSIC, MODERN, MINIMAL, PROFESSIONAL
  isDefault            Boolean  @default(false)
  isBuiltIn            Boolean  @default(false)
  primaryColor         String   @default("#2563eb") // Primary brand hex color
  secondaryColor       String   @default("#64748b")
  fontFamily           String   @default("Inter") // Inter, Roboto, Outfit, Courier
  fontSize             String   @default("NORMAL") // COMPACT, NORMAL, LARGE
  logoPosition         String   @default("LEFT") // LEFT, CENTER, RIGHT
  headerAlignment      String   @default("LEFT")
  showCompanyAddress   Boolean  @default(true)
  showPhone            Boolean  @default(true)
  showEmail            Boolean  @default(true)
  showWebsite          Boolean  @default(true)
  showTaxNumber        Boolean  @default(true)
  visibleColumns       Json?    // ["name", "description", "qty", "price", "discount", "tax", "total"]
  visibleSummaryFields Json?    // ["subtotal", "discount", "tax", "grandTotal", "amountPaid", "balance"]
  thankYouMessage      String?
  footerText           String?
  defaultTerms         String?
  createdById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([companyId])
  @@index([isDefault])
  @@map("invoice_templates")
}

/// CompanyBranding model
model CompanyBranding {
  id          String   @id @default(uuid())
  companyId   String   @unique
  companyName String?
  logoUrl     String?
  taxNumber   String?
  website     String?
  phone       String?
  email       String?
  address     String?
  city        String?
  state       String?
  zip         String?
  country     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_brandings")
}

// ==========================================
// QUOTATION & ESTIMATION SYSTEM MODELS
// ==========================================

/// Quotation model
model Quotation {
  id                 String          @id @default(uuid())
  companyId          String
  quoteNumber        String          // e.g. QTN-000001
  customerId         String
  leadId             String?
  salesRepId         String?
  estimateType       String          @default("FIXED_PRICE") // FIXED_PRICE, HOURLY, MONTHLY, CUSTOM
  quoteDate          DateTime        @default(now())
  expiryDate         DateTime
  status             QuotationStatus @default(DRAFT)
  currency           String          @default("USD")
  subtotal           Float           @default(0)
  discountAmount     Float           @default(0)
  taxAmount          Float           @default(0)
  grandTotal         Float           @default(0)
  notes              String?
  termsConditions    String?
  version            Int             @default(1)
  sentAt             DateTime?
  viewedAt           DateTime?
  acceptedAt         DateTime?
  rejectedAt         DateTime?
  convertedAt        DateTime?
  convertedProjectId  String?
  convertedInvoiceId  String?
  deletedAt          DateTime?
  createdById        String?
  updatedById        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  salesRep  User?     @relation("QuotationSalesRep", fields: [salesRepId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("QuotationAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?     @relation("QuotationUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  items     QuotationItem[]
  versions  QuotationVersion[]

  @@unique([companyId, quoteNumber])
  @@index([companyId])
  @@index([customerId])
  @@index([leadId])
  @@index([status])
  @@index([expiryDate])
  @@index([deletedAt])
  @@map("quotations")
}

/// QuotationItem model
model QuotationItem {
  id           String   @id @default(uuid())
  quotationId  String
  name         String
  description  String?
  quantity     Float    @default(1)
  unitPrice    Float    @default(0)
  discountRate Float    @default(0)
  taxRate      Float    @default(0)
  lineTotal    Float    @default(0)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

/// QuotationVersion model
model QuotationVersion {
  id            String   @id @default(uuid())
  quotationId   String
  versionNumber Int
  snapshotData  Json     // Full snapshot JSON of header & items
  changeNotes   String?
  createdById   String?
  createdAt     DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("QuotationVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@index([createdById])
  @@map("quotation_versions")
}

/// PaymentNote model (internal team notes on payments and invoices)
model PaymentNote {
  id          String   @id @default(uuid())
  companyId   String
  paymentId   String?
  invoiceId   String?
  content     String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payment   InvoicePayment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice   Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("PaymentNoteAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_notes")
}

// ==========================================
// EXPENSE MANAGEMENT SYSTEM MODELS
// ==========================================

/// ExpenseCategory model
model ExpenseCategory {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  isBuiltIn   Boolean  @default(false)
  color       String   @default("#3B82F6")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("ExpenseCategoryAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  expenses  Expense[]

  @@index([companyId])
  @@map("expense_categories")
}

/// Vendor model
model Vendor {
  id            String   @id @default(uuid())
  companyId     String
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("VendorAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  expenses  Expense[]

  @@index([companyId])
  @@map("vendors")
}

/// Expense model
model Expense {
  id            String        @id @default(uuid())
  companyId     String
  title         String
  description   String?
  categoryId    String
  amount        Float
  expenseDate   DateTime      @default(now())
  vendorId      String?
  projectId     String?
  employeeId    String?
  paymentMethod String        @default("BANK_TRANSFER") // CASH, BANK_TRANSFER, CREDIT_CARD, DEBIT_CARD, CHEQUE, MOBILE_WALLET, OTHER
  status        ExpenseStatus @default(PENDING_APPROVAL)
  receiptUrl    String?
  receiptName   String?
  receiptSize   Int?
  notes         String?
  reviewedById  String?
  reviewedAt    DateTime?
  approvalNotes String?
  deletedAt     DateTime?
  createdById   String?
  updatedById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  vendor     Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  project    Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  employee   User?           @relation("ExpenseEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  reviewedBy User?           @relation("ExpenseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdBy  User?           @relation("ExpenseAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy  User?           @relation("ExpenseUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([categoryId])
  @@index([vendorId])
  @@index([projectId])
  @@index([employeeId])
  @@index([status])
  @@index([deletedAt])
  @@map("expenses")
}

/// FinancialDashboardPreference stores per-user customizable dashboard widget layout preferences.
model FinancialDashboardPreference {
  id               String   @id @default(uuid())
  companyId        String
  userId           String   @unique
  visibleWidgets   Json?
  widgetOrder      Json?
  defaultDateRange String   @default("THIS_YEAR")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@map("financial_dashboard_preferences")
}







